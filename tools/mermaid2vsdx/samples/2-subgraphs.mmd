    subgraph Cloud[Cloud region]
        direction TB
        LB[Load balancer]
        subgraph Web[Web tier]
            W1[Web 1]
            W2[Web 2]
        end
        subgraph Data[Data tier]
            DB[(Primary DB)]
            R[(Replica)]
